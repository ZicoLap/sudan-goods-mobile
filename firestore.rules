rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if user has customer role (via Custom Claims or Firestore role field)
    // Supports both: request.auth.token.role (Custom Claims) and request.auth.token.firestoreRole (backup)
    function isCustomer() {
      return isSignedIn() && (
        request.auth.token.role == 'customer' ||
        request.auth.token.firestoreRole == 'customer'
      );
    }

    // Check if user owns the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Check if user is admin (for admin operations)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.firestoreRole == 'admin'
      );
    }

    // ============================================
    // USERS COLLECTION - SERVER ONLY WRITES
    // ============================================

    match /users/{userId} {
      // Users can read their own profile regardless of role
      // Admin can read any user profile
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); // Only admins can list all users

      // NO client-side writes - all writes go through Cloud Functions
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ============================================
    // FOLLOWING SUBCOLLECTION (Customer Feature)
    // ============================================

    match /users/{userId}/following/{storeId} {
      // Only customers can follow stores
      allow read: if isOwner(userId) && isCustomer();
      allow create: if isOwner(userId) && isCustomer()
        && request.resource.data.storeId == storeId;
      allow delete: if isOwner(userId) && isCustomer();
    }

    // ============================================
    // STORES COLLECTION
    // ============================================

    // Main store documents - public read for approved/active stores
    match /stores/{storeId} {
      // Anyone can read approved stores (needed for browsing)
      // Vendors can read their own stores even if not approved yet
      allow get: if resource.data.isApproved == true && resource.data.isActive == true
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow list: if isCustomer() || isAdmin(); // Only customers and admins can browse stores

      // No client-side writes - all store management via Cloud Functions
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Store followers subcollection (social feature)
    match /stores/{storeId}/followers/{userId} {
      // Customers can see who follows a store
      allow read: if isCustomer() || isAdmin();

      // Customers can follow/unfollow stores
      allow create: if isCustomer() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['userId','followedAt'])
        && request.resource.data.userId == userId
        && get(/databases/$(database)/documents/stores/$(storeId)).data.isActive == true
        && get(/databases/$(database)/documents/stores/$(storeId)).data.isApproved == true;

      allow update: if false; // No updates allowed
      allow delete: if isCustomer() && request.auth.uid == userId;
    }

    // Store products subcollection
    match /stores/{storeId}/products/{productId} {
      // Customers can browse products from approved stores
      allow read: if isCustomer() || isAdmin()
        || (get(/databases/$(database)/documents/stores/$(storeId)).data.isApproved == true
            && get(/databases/$(database)/documents/stores/$(storeId)).data.isActive == true);

      // No client-side product management
      allow write: if false;
    }

    // Store collections (product groups)
    match /stores/{storeId}/collections/{collectionId} {
      allow read: if isCustomer() || isAdmin()
        || (get(/databases/$(database)/documents/stores/$(storeId)).data.isApproved == true);
      allow write: if false;
    }

    // ============================================
    // PRODUCTS COLLECTION (Global Products)
    // ============================================

    match /products/{productId} {
      // Customers can read products
      allow get: if isCustomer() || isAdmin();
      allow list: if isCustomer() || isAdmin();

      // No client-side product creation
      allow write: if false;
    }

    // ============================================
    // CATEGORIES COLLECTION
    // ============================================

    match /categories/{categoryId} {
      // Customers can browse categories
      allow read: if isCustomer() || isAdmin() || !isSignedIn(); // Allow for browsing
      allow write: if isAdmin(); // Only admins can manage categories
    }

    // ============================================
    // CARTS COLLECTION (Customer Shopping Carts)
    // ============================================

    match /carts/{cartId} {
      // Only the cart owner (customer) can access their cart
      allow get: if isOwner(cartId) && isCustomer();
      allow list: if isCustomer() && request.auth.uid == resource.data.userId;

      // Customers can create and update their own cart
      allow create: if isOwner(cartId) && isCustomer()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(cartId) && isCustomer()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(cartId) && isCustomer();
    }

    // ============================================
    // ORDERS COLLECTION
    // ============================================

    match /orders/{orderId} {
      // Customers can read their own orders
      allow get: if isCustomer() && resource.data.customerId == request.auth.uid;
      allow list: if isCustomer() && resource.data.customerId == request.auth.uid;

      // Customers can create orders
      allow create: if isCustomer()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'pending';

      // No client-side order updates (handled by Cloud Functions)
      allow update: if false;
      allow delete: if false;
    }

    // ============================================
    // CHATS / MESSAGES (Customer Support)
    // ============================================

    match /chats/{chatId} {
      // Customers can access chats where they are participants
      allow read: if isCustomer()
        && (resource.data.participants.hasAny([request.auth.uid]));
      allow list: if isCustomer()
        && (resource.data.participants.hasAny([request.auth.uid]));

      // Customers can create support chats
      allow create: if isCustomer()
        && request.resource.data.participants.hasAny([request.auth.uid]);

      allow update: if false;
      allow delete: if false;
    }

    match /chats/{chatId}/messages/{messageId} {
      // Customers can read messages in their chats
      allow read: if isCustomer()
        && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);

      // Customers can send messages in their chats
      allow create: if isCustomer()
        && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid])
        && request.resource.data.senderId == request.auth.uid;

      allow update: if false;
      allow delete: if false;
    }

    // ============================================
    // NOTIFICATIONS COLLECTION
    // ============================================

    match /notifications/{notificationId} {
      // Customers can read their own notifications
      allow read: if isCustomer() && resource.data.userId == request.auth.uid;
      allow list: if isCustomer() && resource.data.userId == request.auth.uid;

      // No client-side notification creation
      allow write: if false;
    }

    // ============================================
    // REVIEWS / RATINGS
    // ============================================

    match /stores/{storeId}/reviews/{reviewId} {
      // Anyone can read reviews (for store reputation)
      allow read: if isCustomer() || !isSignedIn();

      // Customers can create reviews for stores they've interacted with
      // (In production, verify purchase via Cloud Function)
      allow create: if isCustomer()
        && request.resource.data.customerId == request.auth.uid;

      allow update: if isCustomer() && isOwner(request.resource.data.customerId);
      allow delete: if false; // Reviews persist
    }

    // ============================================
    // DEFAULT DENY
    // ============================================

    // Deny access to any unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
